<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_pt_at" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pt.at</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Faturação Certificada AT Portugal (ZoneSoft API / Ponte)" id="pt_at_certified_invoicing_block">
                    <setting string="Provedor de Faturação" help="Selecione o provedor de faturação certificada">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="pt_at_provider" class="col-lg-3 o_light_label"/>
                                <field name="pt_at_provider"/>
                            </div>
                            <div class="row mt8">
                                <label for="pt_at_environment" class="col-lg-3 o_light_label"/>
                                <field name="pt_at_environment"/>
                            </div>
                            <div class="row mt8">
                                <field name="pt_at_auto_send" class="oe_inline"/>
                                <label for="pt_at_auto_send" string="Enviar automaticamente para a API ao confirmar a fatura"/>
                            </div>
                        </div>

                        <!-- ZoneSoft specific configuration -->
                        <div class="content-group mt16" invisible="pt_at_provider != 'zonesoft'">
                            <h4 class="text-primary">Credenciais ZoneSoft REST API v3</h4>
                            <div class="row mt8">
                                <label for="pt_at_app_key" class="col-lg-3 o_light_label"/>
                                <field name="pt_at_app_key" password="1"/>
                            </div>
                            <div class="row mt8">
                                <label for="pt_at_app_secret" class="col-lg-3 o_light_label"/>
                                <field name="pt_at_app_secret" password="1"/>
                            </div>
                            <div class="row mt8">
                                <label for="pt_at_client_id" class="col-lg-3 o_light_label"/>
                                <field name="pt_at_client_id"/>
                            </div>
                            <div class="row mt8">
                                <label for="pt_at_store_id" class="col-lg-3 o_light_label"/>
                                <field name="pt_at_store_id"/>
                            </div>
                        </div>

                        <!-- Generic API configuration -->
                        <div class="content-group mt16" invisible="pt_at_provider != 'generic'">
                            <h4 class="text-primary">API REST Genérica Customizada</h4>
                            <div class="row mt8">
                                <label for="pt_at_api_endpoint" class="col-lg-3 o_light_label"/>
                                <field name="pt_at_api_endpoint"/>
                            </div>
                            <div class="row mt8">
                                <label for="pt_at_api_token" class="col-lg-3 o_light_label"/>
                                <field name="pt_at_api_token" password="1"/>
                            </div>
                        </div>

                        <div class="content-group mt16">
                            <div class="row mt8">
                                <label for="pt_at_http_timeout" class="col-lg-3 o_light_label"/>
                                <field name="pt_at_http_timeout"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
